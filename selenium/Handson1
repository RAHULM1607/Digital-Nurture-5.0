# Unit test example (test_unit_crud.py)
import pytest
from unittest.mock import MagicMock, AsyncMock
from crud import create_course
from schemas import CourseCreate

@pytest.mark.asyncio
async def test_create_course_unit():
    """Unit test for create_course function - tests single function in isolation"""
    # Mock dependencies
    mock_db = AsyncMock()
    
    # Create test data
    course_data = CourseCreate(
        name="Unit Test Course",
        code="UNIT101",
        credits=4,
        department_id=1,
        description="This is a unit test"
    )
    
    # Execute function
    result = await create_course(mock_db, course_data)
    
    # Assertions
    assert result.name == "Unit Test Course"
    assert result.code == "UNIT101"
    assert result.credits == 4
    assert result.department_id == 1
    
    # Verify interactions
    mock_db.add.assert_called_once()
    mock_db.commit.assert_called_once()
    mock_db.refresh.assert_called_once()


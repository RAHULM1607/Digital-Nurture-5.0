20. Flaky Tests: Definition and Solutions
Definition

A flaky test is a test that produces non-deterministic results - it sometimes passes and sometimes fails without any changes to the code or test itself. Flaky tests undermine confidence in the test suite because failures may be false positives or false negatives.

Impact of Flaky Tests:

    Reduced Trust: Team stops trusting test results

    Wasted Time: Investigating false failures

    Masked Real Bugs: Real issues may be ignored

    Slower CI/CD: Flaky tests cause pipeline failures and delays

    Increased Costs: Time spent debugging flaky tests

Example of a Flaky Test
python

# Selenium example - Flaky test
def test_course_creation_ui():
    driver = webdriver.Chrome()
    driver.get("https://coursemanager.example.com")
    
    # Click "Create Course" button
    create_btn = driver.find_element(By.ID, "create-course-btn")
    create_btn.click()
    
    # Wait for modal to appear (this is flaky!)
    time.sleep(2)  # Static wait - may fail on slow networks
    modal = driver.find_element(By.ID, "course-modal")
    
    # Fill in course details
    name_input = driver.find_element(By.ID, "course-name")
    name_input.send_keys("Test Course")
    
    # Click submit
    submit_btn = driver.find_element(By.ID, "submit-course")
    submit_btn.click()
    
    # Wait for success message (this is flaky!)
    time.sleep(3)  # Static wait - may fail on slow response
    success_msg = driver.find_element(By.CLASS_NAME, "success-message")
    
    assert "Course created successfully" in success_msg.text

from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

def test_course_creation_ui_fixed():
    driver = webdriver.Chrome()
    driver.get("https://coursemanager.example.com")
    
    # Use explicit wait instead of sleep
    wait = WebDriverWait(driver, 10)
    
    # Wait for button to be clickable
    create_btn = wait.until(
        EC.element_to_be_clickable((By.ID, "create-course-btn"))
    )
    create_btn.click()
    
    # Wait for modal to be visible
    modal = wait.until(
        EC.visibility_of_element_located((By.ID, "course-modal"))
    )
    
    # Fill in course details
    name_input = driver.find_element(By.ID, "course-name")
    name_input.send_keys("Test Course")
    
    # Click submit
    submit_btn = driver.find_element(By.ID, "submit-course")
    submit_btn.click()
    
    # Wait for success message
    success_msg = wait.until(
        EC.visibility_of_element_located((By.CLASS_NAME, "success-message"))
    )
    
    assert "Course created successfully" in success_msg.text

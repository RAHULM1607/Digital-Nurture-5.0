import React, { useState, useEffect } from 'react';
import Header from './components/Header';
import Footer from './components/Footer';
import CourseCard from './components/CourseCard';
import StudentProfile from './components/StudentProfile';
import { initialCourses } from './data/courses';

// Step 61: App component - clean minimal shell
function App() {
  // ============================================
  // TASK 2: State with useState
  // ============================================
  
  // Step 66: State for courses
  const [courses, setCourses] = useState([]);
  
  // Step 72: Loading state
  const [loading, setLoading] = useState(true);
  
  // Step 73: Error state
  const [error, setError] = useState(null);
  
  // Step 68: Search state
  const [searchTerm, setSearchTerm] = useState('');
  
  // Step 69: Enrolled courses state
  const [enrolledCourses, setEnrolledCourses] = useState([]);

  // ============================================
  // TASK 3: useEffect Hook
  // ============================================
  
  // Step 71: Fetch courses from API on mount
  useEffect(() => {
    const fetchCourses = async () => {
      setLoading(true);
      setError(null);
      
      try {
        // Fetch from JSONPlaceholder /posts
        const response = await fetch('https://jsonplaceholder.typicode.com/posts');
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const data = await response.json();
        
        // Map first 5 posts to course-like objects
        const mappedCourses = data.slice(0, 5).map((post, index) => ({
          id: post.id,
          name: post.title.substring(0, 30), // Shorten title
          code: `CS${String(index + 1).padStart(3, '0')}`,
          credits: Math.floor(Math.random() * 3) + 2, // Random credits 2-4
          grade: ['A', 'A-', 'B+', 'B', 'B-'][Math.floor(Math.random() * 5)]
        }));
        
        setCourses(mappedCourses);
        setLoading(false);
        
        console.log('✅ Courses loaded from API:', mappedCourses);
      } catch (err) {
        console.error('❌ Error fetching courses:', err);
        setError(err.message);
        setLoading(false);
        
        // Fallback to initial data if API fails
        setCourses(initialCourses);
      }
    };
    
    fetchCourses();
  }, []); // Empty dependency array - runs once after mount
  
  // Step 75: useEffect with dependency array to log course changes
  useEffect(() => {
    if (courses.length > 0) {
      console.log(`📝 Courses updated! Total courses: ${courses.length}`);
    }
    
    // Explanation of dependency array:
    // The dependency array [courses] means this effect runs whenever the 'courses' state changes.
    // Without the dependency array, this effect would run after EVERY render, potentially
    // causing infinite loops if it also updates state. With an empty array [], it runs only once.
    // With [courses], it runs only when courses changes, which is more efficient and predictable.
  }, [courses]); // This effect runs whenever courses state changes

  // ============================================
  // TASK 2: Event Handlers
  // ============================================
  
  // Step 68: Handle search input
  const handleSearch = (e) => {
    setSearchTerm(e.target.value);
  };
  
  // Step 69: Handle enrollment
  const handleEnroll = (courseId) => {
    setEnrolledCourses(prev => {
      // Check if course is already enrolled
      const isEnrolled = prev.some(course => course.id === courseId);
      
      if (isEnrolled) {
        // Remove from enrolled
        return prev.filter(course => course.id !== courseId);
      } else {
        // Add to enrolled
        const courseToAdd = courses.find(c => c.id === courseId);
        return [...prev, courseToAdd];
      }
    });
  };
  
  // Filter courses based on search term
  const filteredCourses = courses.filter(course =>
    course.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
    course.code.toLowerCase().includes(searchTerm.toLowerCase())
  );
  
  // Check if a course is enrolled
  const isCourseEnrolled = (courseId) => {
    return enrolledCourses.some(course => course.id === courseId);
  };

  // ============================================
  // RENDER
  // ============================================
  
  return (
    <div className="app">
      {/* Task 64: Header with siteName prop and enrolled count */}
      <Header 
        siteName="Student Portal" 
        enrolledCount={enrolledCourses.length}
      />
      
      {/* Step 68: Search input */}
      <div className="search-section">
        <input
          type="text"
          className="search-input"
          placeholder="🔍 Search courses by name or code..."
          value={searchTerm}
          onChange={handleSearch}
        />
      </div>
      
      {/* Step 72: Loading state */}
      {loading && (
        <div className="loading">Loading courses from API...</div>
      )}
      
      {/* Step 73: Error state */}
      {error && !loading && (
        <div className="error">
          ⚠️ Error loading courses: {error}
          <br />
          <small>Showing fallback data</small>
        </div>
      )}
      
      {/* Step 67: Map over courses to render CourseCards */}
      {!loading && (
        <div className="course-grid">
          {filteredCourses.length > 0 ? (
            filteredCourses.map(course => (
              <CourseCard
                key={course.id}
                {...course}
                isEnrolled={isCourseEnrolled(course.id)}
                onEnroll={handleEnroll}
              />
            ))
          ) : (
            <p style={{ textAlign: 'center', padding: '40px', color: '#666' }}>
              No courses found matching "{searchTerm}"
            </p>
          )}
        </div>
      )}
      
      {/* Task 74: StudentProfile component with local state */}
      <StudentProfile />
      
      {/* Task 63: Footer component */}
      <Footer />
    </div>
  );
}

export default App;

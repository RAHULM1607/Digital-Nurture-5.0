// Step 45: Write a function fetchUser using Promise chaining
console.log('\n Step 45: Promise Chaining');
console.log('-'.repeat(40));

const fetchUser = (id) => {
  return fetch(`https://jsonplaceholder.typicode.com/users/${id}`)
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(user => {
      console.log(`User ${id} (Promise chaining): ${user.name}`);
      return user;
    })
    .catch(error => {
      console.error(`Error fetching user ${id}:`, error.message);
    });
};

// Test the promise chain
fetchUser(1);

// Step 46: Rewrite the same function using async/await and try/catch
console.log('\n📌 Step 46: Async/Await with try/catch');
console.log('-'.repeat(40));

const fetchUserAsync = async (id) => {
  try {
    const response = await fetch(`https://jsonplaceholder.typicode.com/users/${id}`);
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    const user = await response.json();
    console.log(`User ${id} (async/await): ${user.name}`);
    return user;
  } catch (error) {
    console.error(`Error fetching user ${id}:`, error.message);
  }
};

// Test the async/await version
await fetchUserAsync(1);

// Step 47: Write a function fetchAllCourses() that simulates network delay
console.log('\n Step 47: Simulated network delay');
console.log('-'.repeat(40));

const fetchAllCourses = () => {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve(courses);
    }, 1000);
  });
};

// Step 48: Call fetchAllCourses() and render course cards with loading message
console.log('\n Step 48: Fetch and render courses with loading state');
console.log('-'.repeat(40));

const renderCourses = async () => {
  const courseGrid = document.querySelector('.course-grid');
  const loadingElement = document.getElementById('course-loading');
  const totalCreditsElement = document.getElementById('total-credits');
  
  try {
    // Show loading message
    loadingElement.style.display = 'block';
    courseGrid.innerHTML = '';
    console.log('⏳ Loading courses...');
    
    // Fetch courses with simulated delay
    const courseData = await fetchAllCourses();
    
    // Clear loading message
    loadingElement.style.display = 'none';
    console.log(' Courses loaded successfully!');
    
    // Calculate total credits
    const totalCredits = courseData.reduce((sum, course) => sum + course.credits, 0);
    
    // Render each course
    courseData.forEach(course => {
      const article = document.createElement('article');
      article.className = 'course-card';
      article.innerHTML = `
        <h3>${course.name}</h3>
        <div class="course-code">${course.code}</div>
        <div class="course-credits">📖 ${course.credits} credits</div>
        <div class="course-grade">Grade: ${course.grade}</div>
      `;
      courseGrid.appendChild(article);
    });
    
    // Update total credits
    totalCreditsElement.textContent = `Total Credits: ${totalCredits}`;
    
    console.log(`📊 Rendered ${courseData.length} courses, total credits: ${totalCredits}`);
    
  } catch (error) {
    console.error('Error loading courses:', error);
    loadingElement.textContent = '❌ Failed to load courses. Please refresh.';
    loadingElement.style.color = '#d63031';
  }
};

// Call the render function
await renderCourses();

// Step 49: Demonstrate Promise.all()
console.log('\nStep 49: Promise.all() - Fetch users 1 and 2 simultaneously');
console.log('-'.repeat(40));

const fetchMultipleUsers = async () => {
  try {
    const [user1, user2] = await Promise.all([
      fetch('https://jsonplaceholder.typicode.com/users/1').then(res => {
        if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
        return res.json();
      }),
      fetch('https://jsonplaceholder.typicode.com/users/2').then(res => {
        if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
        return res.json();
      })
    ]);
    
    console.log(` Promise.all completed!`);
    console.log(`   User 1: ${user1.name}`);
    console.log(`   User 2: ${user2.name}`);
    
  } catch (error) {
    console.error('Error with Promise.all:', error.message);
  }
};

await fetchMultipleUsers();


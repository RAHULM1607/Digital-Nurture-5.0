// Step 50: Create reusable async function apiFetch
console.log('\n📌 Step 50: Reusable apiFetch function');
console.log('-'.repeat(40));

const apiFetch = async (url) => {
  const response = await fetch(url);
  
  if (!response.ok) {
    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
  }
  
  return response.json();
};

// Step 51: Use apiFetch to load and render posts
console.log('\n📌 Step 51: Loading and rendering posts');
console.log('-'.repeat(40));

// Step 52: Loading spinner functionality
const showLoading = () => {
  const indicator = document.getElementById('loading-indicator');
  indicator.classList.remove('hidden');
  document.getElementById('notifications-grid').innerHTML = '';
  document.getElementById('error-container').classList.add('hidden');
};

const hideLoading = () => {
  document.getElementById('loading-indicator').classList.add('hidden');
};

const showError = (message) => {
  const errorContainer = document.getElementById('error-container');
  const errorMessage = document.querySelector('.error-message');
  errorMessage.textContent = `❌ ${message}`;
  errorContainer.classList.remove('hidden');
  document.getElementById('notifications-grid').innerHTML = '';
};

const renderNotifications = (posts) => {
  const grid = document.getElementById('notifications-grid');
  grid.innerHTML = '';
  
  posts.slice(0, 10).forEach(post => {
    const card = document.createElement('div');
    card.className = 'notification-card';
    card.innerHTML = `
      <h4>📌 ${post.title}</h4>
      <div class="notification-body">${post.body}</div>
      <div class="notification-id">Post #${post.id} | User ${post.userId}</div>
    `;
    grid.appendChild(card);
  });
};

// Main function to load notifications
const loadNotifications = async (url = 'https://jsonplaceholder.typicode.com/posts') => {
  showLoading();
  
  try {
    const posts = await apiFetch(url);
    renderNotifications(posts);
    hideLoading();
    console.log(`✅ Loaded ${posts.length} notifications`);
  } catch (error) {
    hideLoading();
    showError(error.message);
    console.error('❌ Error loading notifications:', error.message);
    
    // Step 54: Retry button functionality
    const retryBtn = document.getElementById('retry-btn');
    retryBtn.onclick = () => {
      console.log('🔄 Retrying...');
      loadNotifications(url);
    };
  }
};

// Load initial notifications
await loadNotifications();


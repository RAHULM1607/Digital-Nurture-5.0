// Step 56: Rewrite apiFetch using axios
console.log('\n📌 Step 56: Axios version of apiFetch');
console.log('-'.repeat(40));

const apiFetchAxios = async (url, params = {}) => {
  // Step 58: Axios interceptor is set up below
  const response = await axios.get(url, { 
    params,
    timeout: 5000 // Optional timeout
  });
  return response.data; // Axios automatically parses JSON
};

// Step 58: Add request interceptor
console.log('\n📌 Step 58: Axios Request Interceptor');
console.log('-'.repeat(40));

axios.interceptors.request.use(
  (config) => {
    console.log(`🚀 API call started: ${config.method.toUpperCase()} ${config.url}`);
    return config;
  },
  (error) => {
    console.error('❌ Request interceptor error:', error);
    return Promise.reject(error);
  }
);

// Step 57: Use axios.get with params object
console.log('\n📌 Step 57: Fetching posts for user 1 with axios');
console.log('-'.repeat(40));

const loadUserPosts = async () => {
  try {
    showLoading();
    
    const posts = await apiFetchAxios(
      'https://jsonplaceholder.typicode.com/posts',
      { userId: 1 }
    );
    
    hideLoading();
    console.log(` Loaded ${posts.length} posts for user 1`);
    console.log(' First 3 posts:', posts.slice(0, 3).map(p => p.title));
    
    // Display user posts separately
    const userPostsContainer = document.createElement('div');
    userPostsContainer.id = 'user-posts';
    userPostsContainer.innerHTML = '<h3>User 1 Posts (via Axios)</h3>';
    
    const postList = document.createElement('ul');
    posts.slice(0, 5).forEach(post => {
      const li = document.createElement('li');
      li.textContent = ` ${post.title}`;
      li.style.marginBottom = '5px';
      postList.appendChild(li);
    });
    
    userPostsContainer.appendChild(postList);
    document.getElementById('notifications-container').appendChild(userPostsContainer);
    
  } catch (error) {
    hideLoading();
    console.error(' Axios error:', error.message);
    if (error.response) {
      console.error('Response status:', error.response.status);
      showError(`Axios error: ${error.response.status} - ${error.response.statusText}`);
    } else {
      showError(`Axios error: ${error.message}`);
    }
  }
};

// Load user 1 posts with axios
await loadUserPosts();

